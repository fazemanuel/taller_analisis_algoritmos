  <diagram name="1. Insertar 3" id="rb1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" page="1" pageWidth="1155" pageHeight="800">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Paso 1: insertar 3 como en un ABB (nodo rojo)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=22;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="3&lt;13 → izq; 3&lt;8 → izq; 3&gt;1 → der (está el 6); 3&lt;6 → hijo izquierdo del 6." style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Violación: 6 (rojo) y 3 (rojo) son consecutivos. Abuelo = 1 (negro). Tío = NIL (negro) → hay que ROTAR. 6 es hijo der. de 1 y 3 es hijo izq. de 6 → caso triángulo (derecha-izquierda) → doble rotación." style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=13;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="92" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="Leyenda: rojo/negro = color del nodo · borde naranja = nodos involucrados · NIL = hoja nula (negra)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
