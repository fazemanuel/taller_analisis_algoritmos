        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n  S0[\&quot;1. SECUENCIA ORIGINAL\&quot;]:::heading\n  S0a[\&quot;Arreglo: [8, 9, 11, 15, 19, 20, 21, 7, 3, 2]\&quot;]:::note\n  S0a --&gt; O8\n  O8((8)):::active\n  O8 --- O9((9)):::active\n  O8 --- O11((11)):::active\n  O9 --- O15((15)):::active\n  O9 --- O19((19)):::active\n  O11 --- O20((20)):::active\n  O11 --- O21((21)):::active\n  O15 --- O7((7)):::active\n  O15 --- O3((3)):::active\n  O19 --- O2((2)):::active\n  O2 --&gt; D0[\&quot;Heap máximo: árbol binario completo donde cada padre es mayor o igual que sus hijos.\&quot;]:::note\n\n  D0 --&gt; H0[\&quot;2. CONSTRUCCIÓN DEL HEAP MÁXIMO&lt;br/&gt;Heapify desde el último nodo interno hasta la raíz\&quot;]:::heading\n  H0 --&gt; H1[\&quot;Paso 1: el 11 intercambia con su hijo mayor, 21.&lt;br/&gt;[8, 9, 21, 15, 19, 20, 11, 7, 3, 2]\&quot;]:::note\n  H1 --&gt; A8((8)):::active\n  A8 --- A9((9)):::active\n  A8 --- A21((21)):::swap\n  A9 --- A15((15)):::active\n  A9 --- A19((19)):::active\n  A21 --- A20((20)):::active\n  A21 --- A11((11)):::swap\n  A15 --- A7((7)):::active\n  A15 --- A3((3)):::active\n  A19 --- A2((2)):::active\n\n  A2 --&gt; H2[\&quot;Paso 2: el 9 intercambia con su hijo mayor, 19.&lt;br/&gt;[8, 19, 21, 15, 9, 20, 11, 7, 3, 2]\&quot;]:::note\n  H2 --&gt; B8((8)):::active\n  B8 --- B19((19)):::swap\n  B8 --- B21((21)):::active\n  B19 --- B15((15)):::active\n  B19 --- B9((9)):::swap\n  B21 --- B20((20)):::active\n  B21 --- B11((11)):::active\n  B15 --- B7((7)):::active\n  B15 --- B3((3)):::active\n  B9 --- B2((2)):::active\n\n  B2 --&gt; H3[\&quot;Paso 3: la raíz 8 intercambia primero con 21 y después con 20.&lt;br/&gt;[21, 19, 20, 15, 9, 8, 11, 7, 3, 2]\&quot;]:::note\n  H3 --&gt; C21((21)):::swap\n  C21 --- C19((19)):::active\n  C21 --- C20((20)):::swap\n  C19 --- C15((15)):::active\n  C19 --- C9((9)):::active\n  C20 --- C8((8)):::swap\n  C20 --- C11((11)):::active\n  C15 --- C7((7)):::active\n  C15 --- C3((3)):::active\n  C9 --- C2((2)):::active\n  C2 --&gt; HC[\&quot;Heap máximo construido: 21 en la raíz; todos los padres son mayores o iguales que sus hijos.\&quot;]:::note\n\n  HC --&gt; EX[\&quot;3. EXTRACCIÓN Y ORDENAMIENTO&lt;br/&gt;En cada iteración: intercambiar raíz y último nodo activo, retirar el mayor y aplicar Heapify. El árbol muestra el heap reorganizado; el nodo verde queda fuera del heap.\&quot;]:::heading\n\n  EX --&gt; I1[\&quot;ITERACIÓN 1&lt;br/&gt;Antes: [21, 19, 20, 15, 9, 8, 11, 7, 3, 2]&lt;br/&gt;Intercambio: 21 ↔ 2; extraer 21; Heapify: 2 ↔ 20 y 2 ↔ 11&lt;br/&gt;Heap: [20, 19, 11, 15, 9, 8, 2, 7, 3]&lt;br/&gt;ELEMENTOS ORDENADOS: [21]\&quot;]:::note\n  I1 --&gt; T1((20)):::active\n  T1 --- T11((19)):::active\n  T1 --- T12((11)):::active\n  T11 --- T13((15)):::active\n  T11 --- T14((9)):::active\n  T12 --- T15((8)):::active\n  T12 --- T16((2)):::active\n  T13 --- T17((7)):::active\n  T13 --- T18((3)):::active\n  T1 --&gt; Z1[\&quot;21\&quot;]:::sorted\n\n  Z1 --&gt; I2[\&quot;ITERACIÓN 2&lt;br/&gt;Intercambio: 20 ↔ 3; extraer 20; Heapify: 3 ↔ 19, 3 ↔ 15 y 3 ↔ 7&lt;br/&gt;Heap: [19, 15, 11, 7, 9, 8, 2, 3]&lt;br/&gt;ELEMENTOS ORDENADOS: [20, 21]\&quot;]:::note\n  I2 --&gt; T2((19)):::active\n  T2 --- T21((15)):::active\n  T2 --- T22((11)):::active\n  T21 --- T23((7)):::active\n  T21 --- T24((9)):::active\n  T22 --- T25((8)):::active\n  T22 --- T26((2)):::active\n  T23 --- T27((3)):::active\n  T2 --&gt; Z2[\&quot;20, 21\&quot;]:::sorted\n\n  Z2 --&gt; I3[\&quot;ITERACIÓN 3&lt;br/&gt;Intercambio: 19 ↔ 3; extraer 19; Heapify: 3 ↔ 15 y 3 ↔ 9&lt;br/&gt;Heap: [15, 9, 11, 7, 3, 8, 2]&lt;br/&gt;ELEMENTOS ORDENADOS: [19, 20, 21]\&quot;]:::note\n  I3 --&gt; T3((15)):::active\n  T3 --- T31((9)):::active\n  T3 --- T32((11)):::active\n  T31 --- T33((7)):::active\n  T31 --- T34((3)):::active\n  T32 --- T35((8)):::active\n  T32 --- T36((2)):::active\n  T3 --&gt; Z3[\&quot;19, 20, 21\&quot;]:::sorted\n\n  Z3 --&gt; I4[\&quot;ITERACIÓN 4&lt;br/&gt;Intercambio: 15 ↔ 2; extraer 15; Heapify: 2 ↔ 11 y 2 ↔ 8&lt;br/&gt;Heap: [11, 9, 8, 7, 3, 2]&lt;br/&gt;ELEMENTOS ORDENADOS: [15, 19, 20, 21]\&quot;]:::note\n  I4 --&gt; T4((11)):::active\n  T4 --- T41((9)):::active\n  T4 --- T42((8)):::active\n  T41 --- T43((7)):::active\n  T41 --- T44((3)):::active\n  T42 --- T45((2)):::active\n  T4 --&gt; Z4[\&quot;15, 19, 20, 21\&quot;]:::sorted\n\n  Z4 --&gt; I5[\&quot;ITERACIÓN 5&lt;br/&gt;Intercambio: 11 ↔ 2; extraer 11; Heapify: 2 ↔ 9 y 2 ↔ 7&lt;br/&gt;Heap: [9, 7, 8, 2, 3]&lt;br/&gt;ELEMENTOS ORDENADOS: [11, 15, 19, 20, 21]\&quot;]:::note\n  I5 --&gt; T5((9)):::active\n  T5 --- T51((7)):::active\n  T5 --- T52((8)):::active\n  T51 --- T53((2)):::active\n  T51 --- T54((3)):::active\n  T5 --&gt; Z5[\&quot;11, 15, 19, 20, 21\&quot;]:::sorted\n\n  Z5 --&gt; I6[\&quot;ITERACIÓN 6&lt;br/&gt;Intercambio: 9 ↔ 3; extraer 9; Heapify: 3 ↔ 8&lt;br/&gt;Heap: [8, 7, 3, 2]&lt;br/&gt;ELEMENTOS ORDENADOS: [9, 11, 15, 19, 20, 21]\&quot;]:::note\n  I6 --&gt; T6((8)):::active\n  T6 --- T61((7)):::active\n  T6 --- T62((3)):::active\n  T61 --- T63((2)):::active\n  T6 --&gt; Z6[\&quot;9, 11, 15, 19, 20, 21\&quot;]:::sorted\n\n  Z6 --&gt; I7[\&quot;ITERACIÓN 7&lt;br/&gt;Intercambio: 8 ↔ 2; extraer 8; Heapify: 2 ↔ 7&lt;br/&gt;Heap: [7, 2, 3]&lt;br/&gt;ELEMENTOS ORDENADOS: [8, 9, 11, 15, 19, 20, 21]\&quot;]:::note\n  I7 --&gt; T7((7)):::active\n  T7 --- T71((2)):::active\n  T7 --- T72((3)):::active\n  T7 --&gt; Z7[\&quot;8, 9, 11, 15, 19, 20, 21\&quot;]:::sorted\n\n  Z7 --&gt; I8[\&quot;ITERACIÓN 8&lt;br/&gt;Intercambio: 7 ↔ 3; extraer 7; Heapify: no hace falta (3 > 2)&lt;br/&gt;Heap: [3, 2]&lt;br/&gt;ELEMENTOS ORDENADOS: [7, 8, 9, 11, 15, 19, 20, 21]\&quot;]:::note\n  I8 --&gt; T8((3)):::active\n  T8 --- T81((2)):::active\n  T8 --&gt; Z8[\&quot;7, 8, 9, 11, 15, 19, 20, 21\&quot;]:::sorted\n\n  Z8 --&gt; I9[\&quot;ITERACIÓN 9&lt;br/&gt;Intercambio: 3 ↔ 2; extraer 3&lt;br/&gt;Heap: [2]&lt;br/&gt;ELEMENTOS ORDENADOS: [3, 7, 8, 9, 11, 15, 19, 20, 21]\&quot;]:::note\n  I9 --&gt; T9((2)):::active\n  T9 --&gt; Z9[\&quot;3, 7, 8, 9, 11, 15, 19, 20, 21\&quot;]:::sorted\n\n  Z9 --&gt; F[\&quot;4. RESULTADO FINAL\&quot;]:::heading\n  F --&gt; R[\&quot;[2, 3, 7, 8, 9, 11, 15, 19, 20, 21]\&quot;]:::sorted\n  R --&gt; RF[\&quot;Heapsort utiliza un heap máximo para encontrar repetidamente el elemento mayor. Cada elemento extraído se coloca al final de la zona ordenada. Al terminar las extracciones, se obtiene la secuencia ordenada de menor a mayor.\&quot;]:::note&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="NLxL7Yk8n9DVFvTUDde2-1">
